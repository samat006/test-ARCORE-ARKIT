{
"version": 8,

"glyphs": "file://{MAP_PATH}/fonts/Noto Sans Regular/{range}.pbf",

"sources": {
"corse": {
"type": "vector",
"url": "pmtiles://file://{MAP_PATH}/corse.pmtiles"
}
},

"layers": [


{
  "id": "background",
  "type": "background",
  "paint": {
    "background-color": "#e8e3d8"
  }
},

{
  "id": "ocean",
  "type": "fill",
  "source": "corse",
  "source-layer": "ocean",
  "paint": {
    "fill-color": "#a9d7ed"
  }
},

{
  "id": "land",
  "type": "fill",
  "source": "corse",
  "source-layer": "land",
  "paint": {
    "fill-color": "#e8eadc"
  }
},

{
  "id": "water-polygons",
  "type": "fill",
  "source": "corse",
  "source-layer": "water_polygons",
  "paint": {
    "fill-color": "#a9d7ed"
  }
},

{
  "id": "water-lines",
  "type": "line",
  "source": "corse",
  "source-layer": "water_lines",
  "paint": {
    "line-color": "#6fb7d9",
    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],
      8, 0.5,
      11, 1.2,
      14, 2.5
    ]
  }
},

{
  "id": "water-labels",
  "type": "symbol",
  "source": "corse",
  "source-layer": "water_polygons_labels",
  "layout": {
    "text-field": ["get", "name"],
    "text-font": ["Noto Sans Regular"],
    "text-size": 11
  },
  "paint": {
    "text-color": "#4b91b5",
    "text-halo-color": "#dff2fa",
    "text-halo-width": 1
  }
},

{
  "id": "street-polygons",
  "type": "fill",
  "source": "corse",
  "source-layer": "street_polygons",
  "minzoom": 11,
  "paint": {
    "fill-color": "#f7f4ed"
  }
},

{
  "id": "roads-casing",
  "type": "line",
  "source": "corse",
  "source-layer": "streets",
  "minzoom": 8,

  "layout": {
    "line-cap": "round",
    "line-join": "round"
  },

  "paint": {
    "line-color": [
      "match",
      ["get", "kind"],

      "motorway", "#d59a38",
      "trunk", "#d59a38",
      "primary", "#d59a38",
      "secondary", "#d0b06a",
      "tertiary", "#d6c59b",

      "#c8c3b9"
    ],

    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],

      8, 1.5,
      10, 2.2,
      12, 3.5,
      14, 5.5
    ]
  }
},

{
  "id": "roads-main",
  "type": "line",
  "source": "corse",
  "source-layer": "streets",
  "minzoom": 8,

  "layout": {
    "line-cap": "round",
    "line-join": "round"
  },

  "paint": {
    "line-color": [
      "match",
      ["get", "kind"],

      "motorway", "#f4b942",
      "trunk", "#f4b942",
      "primary", "#f6c85f",
      "secondary", "#fff4c9",
      "tertiary", "#fff8df",

      "#ffffff"
    ],

    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],

      8, 0.8,
      10, 1.4,
      12, 2.3,
      14, 3.8
    ]
  }
},

{
  "id": "roads-minor",
  "type": "line",
  "source": "corse",
  "source-layer": "streets",
  "minzoom": 11,

  "filter": [
    "in",
    ["get", "kind"],
    "residential",
    "service",
    "living_street"
  ],

  "layout": {
    "line-cap": "round",
    "line-join": "round"
  },

  "paint": {
    "line-color": "#ffffff",

    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],
      11, 0.8,
      13, 1.5,
      14, 2.4
    ]
  }
},

{
  "id": "roads-paths",
  "type": "line",
  "source": "corse",
  "source-layer": "streets",
  "minzoom": 12,

  "filter": [
    "in",
    ["get", "kind"],
    "path",
    "track",
    "footway",
    "cycleway"
  ],

  "paint": {
    "line-color": "#b69b72",
    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],
      12, 0.6,
      14, 1.4
    ],
    "line-dasharray": [2, 2]
  }
},

{
  "id": "bridges-casing",
  "type": "line",
  "source": "corse",
  "source-layer": "bridges",
  "paint": {
    "line-color": "#b58b45",
    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],
      8, 2,
      12, 4,
      14, 6
    ]
  }
},

{
  "id": "bridges",
  "type": "line",
  "source": "corse",
  "source-layer": "bridges",
  "paint": {
    "line-color": "#f4c96b",
    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],
      8, 1,
      12, 2.5,
      14, 4
    ]
  }
},

{
  "id": "ferries",
  "type": "line",
  "source": "corse",
  "source-layer": "ferries",
  "paint": {
    "line-color": "#477d99",
    "line-width": 1.5,
    "line-dasharray": [2, 2]
  }
},

{
  "id": "buildings",
  "type": "fill",
  "source": "corse",
  "source-layer": "buildings",
  "minzoom": 13,
  "paint": {
    "fill-color": "#d8c6b0",
    "fill-outline-color": "#bca58b",
    "fill-opacity": [
      "interpolate",
      ["linear"],
      ["zoom"],
      13, 0.45,
      15, 0.85
    ]
  }
},

{
  "id": "sites",
  "type": "fill",
  "source": "corse",
  "source-layer": "sites",
  "minzoom": 13,
  "paint": {
    "fill-color": "#ded8c8",
    "fill-opacity": 0.65
  }
},

{
  "id": "boundaries",
  "type": "line",
  "source": "corse",
  "source-layer": "boundaries",
  "minzoom": 8,
  "paint": {
    "line-color": "#a887a1",
    "line-width": [
      "interpolate",
      ["linear"],
      ["zoom"],
      8, 0.5,
      12, 1,
      14, 1.5
    ],
    "line-dasharray": [3, 2]
  }
},

{
  "id": "aerialways",
  "type": "line",
  "source": "corse",
  "source-layer": "aerialways",
  "minzoom": 10,
  "paint": {
    "line-color": "#806b55",
    "line-width": 1.5,
    "line-dasharray": [2, 2]
  }
},

{
  "id": "public-transport",
  "type": "line",
  "source": "corse",
  "source-layer": "public_transport",
  "minzoom": 11,
  "paint": {
    "line-color": "#8b4c88",
    "line-width": 2
  }
},

{
  "id": "place-labels",
  "type": "symbol",
  "source": "corse",
  "source-layer": "place_labels",

  "minzoom": 6,

  "filter": [
    "any",
    ["==", ["get", "kind"], "city"],
    ["==", ["get", "kind"], "town"],
    ["==", ["get", "kind"], "capital"],
    ["==", ["get", "kind"], "state_capital"],
    ["==", ["get", "kind"], "village"]
  ],

  "layout": {
    "text-field": ["get", "name"],
    "text-font": ["Noto Sans Regular"],

    "text-size": [
      "interpolate",
      ["linear"],
      ["zoom"],

      6, 10,
      8, 12,
      10, 14,
      12, 17,
      14, 20
    ],

    "text-padding": 2
  },

  "paint": {
    "text-color": "#30352f",
    "text-halo-color": "#ffffff",
    "text-halo-width": 2
  }
},

{
  "id": "street-labels",
  "type": "symbol",
  "source": "corse",
  "source-layer": "street_labels",
  "minzoom": 12,

  "layout": {
    "text-field": ["get", "name"],
    "text-font": ["Noto Sans Regular"],
    "text-size": [
      "interpolate",
      ["linear"],
      ["zoom"],
      12, 9,
      14, 12
    ],

    "symbol-placement": "line",
    "text-rotation-alignment": "map"
  },

  "paint": {
    "text-color": "#66635d",
    "text-halo-color": "#ffffff",
    "text-halo-width": 1.5
  }
},

{
  "id": "street-labels-points",
  "type": "symbol",
  "source": "corse",
  "source-layer": "street_labels_points",
  "minzoom": 13,

  "layout": {
    "text-field": ["get", "name"],
    "text-font": ["Noto Sans Regular"],
    "text-size": 10
  },

  "paint": {
    "text-color": "#65615b",
    "text-halo-color": "#ffffff",
    "text-halo-width": 1.5
  }
},

{
  "id": "boundary-labels",
  "type": "symbol",
  "source": "corse",
  "source-layer": "boundary_labels",
  "minzoom": 8,

  "layout": {
    "text-field": ["get", "name"],
    "text-font": ["Noto Sans Regular"],
    "text-size": 11
  },

  "paint": {
    "text-color": "#8b667f",
    "text-halo-color": "#ffffff",
    "text-halo-width": 2
  }
},

{
  "id": "poi-labels",
  "type": "symbol",
  "source": "corse",
  "source-layer": "pois",
  "minzoom": 13,

  "layout": {
    "text-field": ["get", "name"],
    "text-font": ["Noto Sans Regular"],
    "text-size": [
      "interpolate",
      ["linear"],
      ["zoom"],
      13, 9,
      15, 12
    ],

    "text-offset": [0, 1.2]
  },

  "paint": {
    "text-color": "#744f3b",
    "text-halo-color": "#ffffff",
    "text-halo-width": 1.5
  }
},

{
  "id": "poi-points",
  "type": "circle",
  "source": "corse",
  "source-layer": "pois",
  "minzoom": 12,

  "paint": {
    "circle-radius": [
      "interpolate",
      ["linear"],
      ["zoom"],
      12, 2,
      15, 4
    ],

    "circle-color": "#d85b4a",
    "circle-stroke-color": "#ffffff",
    "circle-stroke-width": 1
  }
}


]
}
